<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.DiemGeo" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/diem_green</item>
        <item name="colorPrimaryDark">@color/diem_green_dark</item>
        <item name="colorAccent">@color/diem_accent</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/diem_green_dark</item>
    </style>

    <style name="Theme.DiemGeo.Splash" parent="Theme.DiemGeo">
        <item name="android:windowBackground">@color/splash_scrim</item>
        <item name="android:statusBarColor" tools:targetApi="l">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>
</resources>
